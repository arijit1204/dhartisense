# Copy this file to .env and fill in your own values. Never commit .env.

# --- Groq (assistant and plant-photo second opinion) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# --- Firebase (accounts, email verification, password reset, field storage) ---
# Firebase console > Project settings > General > Your apps > Web app: copy apiKey and projectId.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
# Project settings > Service accounts > Generate new private key. Keep that file OUTSIDE the project folder.
FIREBASE_SERVICE_ACCOUNT_FILE=
# On a host without files, paste the whole key as one line of JSON here instead (use the host's secret store).
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Server ---
DHARTISENSE_HOST=127.0.0.1
DHARTISENSE_PORT=8000
# Set to 1 once the site is served over HTTPS.
DHARTISENSE_COOKIE_SECURE=0
# Extra site addresses allowed to send changes (comma separated), e.g. https://dhartisense.in. The site's own address is always allowed.
DHARTISENSE_ALLOWED_ORIGINS=
